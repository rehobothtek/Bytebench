# Copy this file to .env and fill in real values for local development.
# In production, set these as real environment variables in your hosting
# platform's dashboard instead of using a .env file.
#
# NEVER commit a real .env file (with actual secrets in it) to GitHub —
# only this .env.example template, which has no real values, should be
# committed.

# --- Core Django ---------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Set to False in production
DEBUG=True
# Comma-separated list of your real domain(s) in production, e.g.
# rehobothtek.com,www.rehobothtek.com — leave as * only for local dev
ALLOWED_HOSTS=*

# NOTE: with DEBUG=False the site refuses to start unless SECRET_KEY is set to
# something other than the development placeholder and ALLOWED_HOSTS is a real
# domain list. Everything else below is optional, and anything still on its
# development value is reported as a startup warning rather than a failure.

# --- Site URL (production) ------------------------------------------------
# Your public origin, no trailing slash, e.g. https://rehobothtek.com
# Used for <link rel="canonical"> and Open Graph / Twitter URLs. Leave unset
# locally — the tags fall back to the host the request arrived on.
SITE_URL=

# --- Database (optional) --------------------------------------------------
# Leave unset to use SQLite (fine for development and small stores). Set
# this to switch to PostgreSQL — most hosts give you this connection string
# directly, e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Paystack --------------------------------------------------------------
# From https://dashboard.paystack.com -> Settings -> API Keys & Webhooks
# Leave unset to use Paystack's published test keys, which run the whole
# payment flow without moving real money. Production warns at startup while
# test keys are in use.
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_OWN_KEY
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_OWN_KEY

# --- Email (optional — leave unset to just print emails to the terminal) ---
# In production, leaving the console backend on means order/repair/contact
# notifications are never delivered. A startup warning says so.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# STARTTLS (port 587). For implicit TLS on port 465 use EMAIL_USE_SSL=True
# instead — setting that one turns EMAIL_USE_TLS off automatically.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Seconds to wait on the mail server before giving up (keeps a dead SMTP
# host from hanging a checkout request).
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Must be an address on a real domain — .local is not deliverable.
DEFAULT_FROM_EMAIL=RehoBothTek Website <no-reply@rehobothtek.local>
# Where Django's own error mail goes. Defaults to DEFAULT_FROM_EMAIL.
SERVER_EMAIL=

# --- Logging (optional) ---------------------------------------------------
# INFO by default; the app's loggers (shop.*) and Django's request/security
# loggers use this. django.request stays at ERROR regardless.
LOG_LEVEL=INFO
# Set to a writable directory to also keep a rotating bytebench.log there.
# Unset (the default) logs to stderr only, which is what hosting platforms
# capture anyway.
LOG_DIR=

# --- Business details (optional — sensible defaults are already set in settings.py) ---
WHATSAPP_NUMBER=2348113956538
SITE_EMAIL=observernathan124@gmail.com
TELEGRAM_USERNAME=rehobothtek
ADMIN_NOTIFY_EMAIL=
SHOP_ADDRESS=No3 Charismatic Crescent, Ugbokolo, Benue State, Nigeria
